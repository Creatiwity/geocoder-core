# Public name of the API; Caddy gets its certificate (DNS must point here).
GEOCODER_DOMAIN=geocoder.example.com
GEOCODER_VERSION=v0.2.0
# fr (BAN), lu (BD-Adresses), be (BeST Address).
GEOCODER_COUNTRIES=fr,lu,be
# Without ?country=. Empty: the first of GEOCODER_COUNTRIES.
GEOCODER_DEFAULT_COUNTRY=
SENTRY_DSN=
# Signed prebuilt indexes (built by the geocoder-core CI): `update` downloads
# them instead of building. Empty: built here from the sources.
GEOCODER_INDEX_BASE_URL=
# Serving: ~300 MB plus page cache. Update: ~200 MB with prebuilt indexes,
# ~5 GB at peak when building France here.
API_MEM_LIMIT=1g
UPDATE_MEM_LIMIT=6g
